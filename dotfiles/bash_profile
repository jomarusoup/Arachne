#==========================================================================
# .bash_profile
#==========================================================================

# Get the aliases and functions
if [ -f ~/.bashrc ]; then
    . ~/.bashrc
fi

# User specific environment and startup programs

#--------------------------------------------------------------------------
# COMMON
#--------------------------------------------------------------------------

export LD_LIBRARY_PATH=/lib64:/lib:/usr/local/lib64:
export GITHUB_PERSONAL_ACCESS_TOKEN="__GITHUB_PAT__"  # 실제 값은 로컬에서 직접 입력

export EXINIT='set ai ts=4 sw=4'
set -o vi

HOSTNAME=`hostname`
PS1='$HOSTNAME:$PWD> '

#export LANG="ko_KR.euckr"

export EDITOR=vi
export TERM=xterm-256color

umask 002

#--- [command alias]
alias df='df -BG'
alias ls='ls -aF'
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'

#--------------------------------------------------------------------------
# COMMAND
#--------------------------------------------------------------------------
#--- [search file]
