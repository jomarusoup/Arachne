#-------------------------------------------------------------------------------
# FUNCTION    : sgrep
# DESCRIPTION : 현재 디렉터리 이하 전체 소스 파일에서 키워드 검색
# PARAMETERS  : string keyword - 검색할 키워드
# RETURNED    : 파일명:행번호:내용 형식으로 출력
#-------------------------------------------------------------------------------
sgrep()
{
        #--- C / C++ header & source
        find . -name '*.[hc]'      -print | xargs -r grep -H "$*"
        find . -name '*.cc'         -print | xargs -r grep -H "$*"
        find . -name '*.pc'         -print | xargs -r grep -H "$*"
        find . -name '*.sc'         -print | xargs -r grep -H "$*"
        find . -name '*.gc'         -print | xargs -r grep -H "$*"
        find . -name '*.cp'         -print | xargs -r grep -H "$*"
        find . -name '*.res'        -print | xargs -r grep -H "$*"
        find . -name '*.pgc'        -print | xargs -r grep -H "$*"
        find . -name '*.hpp'        -print | xargs -r grep -H "$*"
        find . -name '*.cpp'        -print | xargs -r grep -H "$*"
        #--- Rust
        find . -name '*.rs'         -print | xargs -r grep -H "$*"
        #--- Python
        find . -name '*.py'         -print | xargs -r grep -H "$*"
        #--- Web (HTML / CSS / JS / TS)
        find . -name '*.html'       -print | xargs -r grep -H "$*"
        find . -name '*.css'        -print | xargs -r grep -H "$*"
        find . -name '*.js'         -print | xargs -r grep -H "$*"
        find . -name '*.ts'         -print | xargs -r grep -H "$*"
        #--- Go
        find . -name '*.go'         -print | xargs -r grep -H "$*"
        #--- Docker
        find . -name 'Dockerfile'   -print | xargs -r grep -H "$*"
        find . -name 'Dockerfile.*' -print | xargs -r grep -H "$*"
        #--- Makefile
        find . -name '[Mm]akefile' -print | xargs -r grep -H "$*"
        find . -name '*.mk'         -print | xargs -r grep -H "$*"
        #--- Shell script
        find . -name '*.sh'         -print | xargs -r grep -H "$*"
        find . -name '*.bash'       -print | xargs -r grep -H "$*"
        #--- SQL
        find . -name '*.sql'        -print | xargs -r grep -H "$*"
        #--- Config / Manifest
        find . -name '*.toml'       -print | xargs -r grep -H "$*"
        find . -name '*.yaml'       -print | xargs -r grep -H "$*"
        find . -name '*.yml'        -print | xargs -r grep -H "$*"
        find . -name '*.json'       -print | xargs -r grep -H "$*"
        #--- Markdown
        find . -name '*.md'         -print | xargs -r grep -H "$*"
}

