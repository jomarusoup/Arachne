        #--- Python
        find . -name '*.py'         -print | xargs -r grep -H -A2 -B2 "$*"
        #--- Web (HTML / CSS / JS / TS)
        find . -name '*.html'       -print | xargs -r grep -H -A2 -B2 "$*"
        find . -name '*.css'        -print | xargs -r grep -H -A2 -B2 "$*"
        find . -name '*.js'         -print | xargs -r grep -H -A2 -B2 "$*"
