rgrep()
{
        find . -name '*.res' -print | xargs grep -H "$*"
}

mgrep()
{
        find . -name '[M|m]akefile' -print | xargs grep -H "$1"
}

ugrep()
{
        find . -name "*.[h|c]" -or -name "*.cc" -or -name "*.pc" -or -name "*.sc" | \
        xargs grep -E $1                                                          | \
        grep -Ev "bak|back|test"                                                  | \
        sed 's/[:|*]/ /g'                                                         | \
        awk '{printf("%s\n", $1);}'                                               | \
        sort                                                                      | \
        uniq
}

vgrep()
{
        find . -name '*.sc' -print | \
        grep -Ev "bak|back|BACK|test|Test|org|OLD|diff|tobe" | \
        xargs grep -Hn "$*" | sort | grep "$*"
        find . -name '*.[h|c]' -print | \
        grep -Ev "bak|back|BACK|test|Test|org|OLD|diff|tobe" | \
        xargs grep -Hn "$*" | sort | grep "$*"
}
