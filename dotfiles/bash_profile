        find . -name '*.pgc'        -print | xargs -r grep -H -A2 -B2 "$*"
        find . -name '*.hpp'        -print | xargs -r grep -H -A2 -B2 "$*"
        find . -name '*.cpp'        -print | xargs -r grep -H -A2 -B2 "$*"
        #--- Rust
