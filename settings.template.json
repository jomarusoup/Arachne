{
  "statusLine": {
    "type": "command",
    "command": "bash \"__HOME__/.claude/statusline-command.sh\""
  },
  "theme": "dark-daltonized",
  "model": "sonnet",
  "permissions": {
    "allow": [
      "Bash(gtask:*)",
      "Bash(gemini-task:*)",
      "Bash(ctask:*)",
      "Bash(codex-task:*)",
      "Bash(atask:*)",
      "Bash(arachne-task:*)"
    ],
    "ask": [
      "Bash(ctask -w:*)",
      "Bash(codex-task -w:*)",
      "Bash(atask -w:*)",
      "Bash(arachne-task -w:*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__HOME__/.claude/hooks/git-bus-check.sh\""
          },
          {
            "type": "command",
            "command": "bash \"__HOME__/.claude/hooks/atask-quota-warn.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__HOME__/.claude/hooks/doc-drift-check.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__HOME__/.claude/hooks/session-start.sh\""
          },
          {
            "type": "command",
            "command": "bash \"__HOME__/.claude/hooks/ua-stale-check.sh\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__HOME__/.claude/hooks/pre-compact.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__HOME__/.claude/hooks/session-end.sh\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "understand-anything@understand-anything": true,
    "taste-skill@taste-skill": true
  }
}
