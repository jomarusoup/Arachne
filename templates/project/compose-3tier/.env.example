# 3티어 로컬 환경 설정 예시. cp .env.example .env 후 값을 바꾼다. .env 는 커밋하지 않는다.
# 아래 비밀번호는 자리표시자다. 로컬 전용 값으로 바꾸고, 운영 값은 절대 쓰지 않는다.

COMPOSE_PROJECT_NAME=app3tier

# 소스 위치 (compose.yaml 기준 상대 경로)
C_SRC_DIR=../c-system/src
SQL_DIR=../sql
C_MODULES=log shm pipeline contract

# C 서버 진입점 (--profile server)
APP_DIR=server
APP_NAME=appd
APP_PORT=7000

# PostgreSQL
POSTGRES_IMAGE=postgres:17.6-bookworm
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-local-only
PG_HOST_PORT=5432

# Oracle Free (--profile oracle). 재현성이 필요하면 태그 대신 digest 로 고정한다
ORACLE_IMAGE=gvenzl/oracle-free:23-slim
ORACLE_PASSWORD=change-me-local-only
APP_USER=app
APP_USER_PASSWORD=change-me-local-only
ORA_HOST_PORT=1521

# Jaeger (--profile tracing)
JAEGER_IMAGE=jaegertracing/jaeger:2.10.0
