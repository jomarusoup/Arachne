# C/C++ profile. The project owns CMakeLists.txt (Makefile 프로젝트는 아래 주석 참고).
git diff --check

# Configure + build — Debug + ASan/UBSan (메모리 오염·UB를 테스트 단계에서 잡는다)
cmake -S . -B build -DCMAKE_BUILD_TYPE=Debug -DCMAKE_C_FLAGS="-fsanitize=address,undefined -fno-omit-frame-pointer -g" -DCMAKE_CXX_FLAGS="-fsanitize=address,undefined -fno-omit-frame-pointer -g"
cmake --build build --parallel

# Test — ctest (GoogleTest/cmocka 연동, sanitizer 활성 바이너리로 실행)
ctest --test-dir build --output-on-failure

# Makefile 프로젝트면 위 cmake/ctest 세 줄을 다음으로 대체:
# make CFLAGS="-fsanitize=address,undefined -fno-omit-frame-pointer -g"
# make test

